  "cards": [
    {
      "dot": "cyan",
      "title": "核心定位",
      "items": [
        "模块化单体控制面管理多个 Claude Code 子进程",
        "任务目录既是状态容器，也是所有成员共享的真实项目工作区"
      ]
    },
    {
      "dot": "violet",
      "title": "调度关键",
      "items": [
        "DAG 只在依赖完成后把节点从 PENDING 解锁为 READY",
        "人工门禁冻结 PRD、架构、原型和最终交付，后台节点只能做可回退准备"
      ]
    },
    {
      "dot": "emerald",
      "title": "恢复与追溯",
      "items": [
        "当前状态使用原子 JSON，高频历史使用追加式 JSONL/NDJSON",
        "浏览器按序号增量轮询；后端重启后可从任务日志恢复会话历史"
      ]
    }
  ]
